.home-page { padding-bottom: 40rpx; }
.hero { position: relative; height: 100vh; min-height: 100vh; overflow: hidden; background: #0d2b21; color: #fff; }
.hero::before { content: ""; position: absolute; z-index: 1; inset: 0; background: rgba(7, 25, 18, .14); }
.hero::after { content: ""; position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 44%; background: linear-gradient(to bottom, rgba(5, 16, 12, 0), rgba(5, 16, 12, .38)); }
.hero-image { position: absolute; width: 100%; height: 100%; }
.hero-top { position: absolute; z-index: 2; top: calc(env(safe-area-inset-top) + 34rpx); left: 42rpx; right: 34rpx; display: flex; align-items: center; justify-content: space-between; font-size: 20rpx; font-weight: 650; letter-spacing: 5rpx; }
.hero-copy { position: absolute; z-index: 2; top: 250rpx; left: 0; right: 0; display: flex; align-items: center; flex-direction: column; text-align: center; text-shadow: 0 4rpx 32rpx rgba(0,0,0,.4); }
.hero-mark { display: block; width: 104rpx; height: auto; margin-bottom: 50rpx; }
.hero-idea { margin-bottom: 20rpx; font: 400 26rpx/1.5 "Songti SC", serif; letter-spacing: 7rpx; }
.hero-title { font: 400 62rpx/1.45 "Songti SC", serif; letter-spacing: 8rpx; }
.hero-title text, .live-title text { display: block; }
.hero-en { margin-top: 30rpx; font-size: 16rpx; letter-spacing: 5rpx; }
.gateway { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 1fr 1rpx 1fr; align-items: stretch; min-height: 350rpx; background: linear-gradient(to bottom, rgba(3,12,9,0), rgba(3,12,9,.94)); color: #fff; }
.gateway button { display: flex; align-items: center; flex-direction: column; justify-content: flex-end; min-height: 260rpx; padding: 130rpx 20rpx 44rpx; border: 0; background: transparent; color: #fff; line-height: 1.4; }
.gateway-en { color: rgba(255,255,255,.72); font-size: 17rpx; font-weight: 700; letter-spacing: 4rpx; }
.gateway-title { margin: 16rpx 0 8rpx; font-size: 44rpx; }
.gateway-note { color: rgba(255,255,255,.7); font-size: 19rpx; }
.gateway-line { align-self: end; width: 1rpx; height: 128rpx; margin-bottom: 48rpx; background: rgba(255,255,255,.28); }
.benefits { background: #f5f1e8; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.quick-grid button { display: grid; grid-template-columns: 76rpx 1fr; align-items: center; column-gap: 20rpx; min-height: 136rpx; padding: 22rpx; border: 1rpx solid rgba(24,59,45,.1); border-radius: 8rpx; background: rgba(255,255,255,.72); text-align: left; line-height: 1.3; }
.quick-mark { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 50%; background: #e4eadf; color: #183b2d; font-size: 30rpx; }
.quick-title, .quick-note { display: block; }
.quick-title { font-size: 25rpx; font-weight: 600; }
.quick-note { margin-top: 8rpx; color: #777d78; font-size: 18rpx; }
.member-feature { padding-top: 0; }
.member-feature > image { display: block; width: 100%; height: 430rpx; border-radius: 8rpx 8rpx 0 0; }
.feature-copy { padding: 40rpx; background: #fff; }
.feature-title { display: block; margin: 14rpx 0; font-size: 46rpx; }
.feature-note { display: block; color: #657068; font-size: 22rpx; line-height: 1.75; }
.feature-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 34rpx; }
.price { margin-right: 14rpx; color: #b36e4b; font: 500 48rpx/1 Georgia, serif; }
.original { color: #989c98; font-size: 20rpx; text-decoration: line-through; }
.feature-row .primary-button { margin: 0; }
.live-card { margin: 0 40rpx; padding: 56rpx 48rpx; background: #0d2b21; color: #fff; }
.live-badge { display: block; margin-bottom: 66rpx; color: #d7866f; font-size: 20rpx; letter-spacing: 2rpx; }
.live-card .eyebrow { color: #a8b7aa; }
.live-title { display: block; margin: 16rpx 0; font-size: 54rpx; line-height: 1.42; }
.live-note { display: block; color: rgba(255,255,255,.68); font-size: 22rpx; line-height: 1.8; }
.live-card button { display: inline-flex; margin: 40rpx 0 0; padding: 18rpx 28rpx; border: 1rpx solid rgba(255,255,255,.35); background: transparent; color: #fff; font-size: 22rpx; line-height: 1.4; }
.origin { margin-top: 64rpx; background: #fff; }
.origin .section-heading button { margin: 0; padding: 0; background: transparent; color: #6f766f; font-size: 22rpx; line-height: 1.4; }
.origin-card { display: block; width: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: #0d2b21; color: #fff; text-align: left; line-height: 1.4; }
.origin-card image { display: block; width: 100%; height: 450rpx; }
.origin-card view { padding: 32rpx 36rpx 36rpx; }
.origin-title, .origin-note { display: block; }
.origin-title { font-size: 36rpx; }
.origin-note { margin-top: 12rpx; color: rgba(255,255,255,.65); font-size: 18rpx; letter-spacing: 1rpx; }
.collab { overflow: hidden; padding-right: 0; }
.collab .section-heading { padding-right: 40rpx; }
.collab-scroll { width: 100%; }
.collab-row { display: flex; width: max-content; padding-right: 40rpx; gap: 20rpx; }
.collab-card { display: flex; align-items: flex-start; flex-direction: column; justify-content: flex-end; width: 476rpx; height: 310rpx; margin: 0; padding: 40rpx; border-radius: 0; color: #fff; text-align: left; line-height: 1.4; }
.collab-card.clay { background: #8d5b42; }
.collab-card.herb { background: #5d7058; }
.collab-card text:first-child { font-size: 18rpx; letter-spacing: 3rpx; opacity: .75; }
.collab-card .serif { margin: 14rpx 0 10rpx; font-size: 34rpx; }
.collab-card text:last-child { font-size: 18rpx; opacity: .75; }
