<view class="me-page">
  <text class="eyebrow">MY TEA LIFE</text>
  <view class="profile"><text class="avatar serif">予</text><view><text class="profile-title serif">{{member ? '下午好，山席会员' : '下午好，茶友'}}</text><text class="profile-note">{{member ? '山席会员 · Lv.1' : '尚未入会'}}</text></view></view>
  <view class="points-card"><view><text>可用茶分</text><text>{{points}}</text></view><button data-name="茶分兑礼" bindtap="showFeature">去兑礼</button></view>
  <view class="order-strip"><button data-name="待付款" bindtap="showFeature"><text>1</text><text>待付款</text></button><button data-name="待收茶" bindtap="showFeature"><text>2</text><text>待收茶</text></button><button data-name="优惠券" bindtap="showFeature"><text>{{couponCount}}</text><text>优惠券</text></button></view>
  <view class="favorites-section">
    <view class="favorites-heading"><text class="serif">我的收藏</text><text>{{favorites.length}} 件</text></view>
    <block wx:if="{{favorites.length}}">
      <button wx:for="{{favorites}}" wx:key="name" class="favorite-card" data-name="{{item.name}}" bindtap="openFavorite">
        <image src="{{item.image}}" mode="aspectFill" />
        <view><text class="favorite-kicker">YU TEA SELECTED</text><text class="favorite-name serif">{{item.name}}</text><text class="favorite-size">{{item.size}}</text><text class="favorite-price">¥{{item.price}}</text></view>
      </button>
    </block>
    <text wx:else class="favorites-empty">收藏喜欢的茶，下一次更快找到它。</text>
  </view>
  <view class="menu-list"><button wx:for="{{menuItems}}" wx:key="*this" data-name="{{item}}" bindtap="showFeature"><text>{{item}}</text><text>›</text></button></view>
</view>
