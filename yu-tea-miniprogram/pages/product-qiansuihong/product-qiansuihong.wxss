page { height: 100%; overflow: hidden; background: #f5f1e8; color: #17231e; font-family: "PingFang SC", sans-serif; }
button::after { border: 0; }
.serif { font-family: "Songti SC", STSong, serif; }
.detail-page { position: relative; width: 100%; height: 100%; overflow: hidden; background: #f5f1e8; }
.detail-scroll { width: 100%; height: 100%; }
.detail-content { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; height: 1030rpx; overflow: hidden; border-radius: 0 0 50% 50% / 0 0 44rpx 44rpx; background: #10241a; color: #f6f0e4; }
.hero-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-actions { position: absolute; z-index: 2; top: calc(42rpx + env(safe-area-inset-top)); right: 40rpx; left: 40rpx; display: flex; justify-content: space-between; }
.hero-actions button { width: 96rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 34rpx; background: rgba(8,24,16,.32); color: #fff; font-size: 22rpx; line-height: 64rpx; }
.hero-copy { position: absolute; z-index: 2; top: 300rpx; left: 48rpx; width: 500rpx; text-shadow: 0 4rpx 24rpx rgba(0,0,0,.36); }
.hero-copy text { display: block; }
.hero-en { margin-bottom: 36rpx; font-family: Georgia, serif; font-size: 18rpx; letter-spacing: 6rpx; }
.hero-title { font-size: 86rpx; line-height: 1.1; letter-spacing: 10rpx; }
.hero-subtitle { margin-top: 36rpx; font-size: 42rpx; line-height: 1.35; letter-spacing: 8rpx; }
.hero-rule, .clay-rule { width: 52rpx; height: 2rpx; margin: 48rpx 0 34rpx; background: rgba(246,240,228,.72); }
.hero-quote { font-size: 28rpx; line-height: 1.7; letter-spacing: 5rpx; }
.facts { display: grid; grid-template-columns: repeat(4, 1fr); min-height: 172rpx; align-items: center; padding: 24rpx 22rpx 18rpx; box-sizing: border-box; }
.facts view { border-left: 1rpx solid rgba(24,59,45,.12); text-align: center; }
.facts view:first-child { border-left: 0; }
.facts text { display: block; color: #8c948d; font-size: 14rpx; letter-spacing: 2rpx; }
.facts text:last-child { margin-top: 10rpx; color: #183b2d; font-size: 24rpx; letter-spacing: 0; white-space: nowrap; }
.section-paper { background: #f8f4eb; }
.aroma { display: grid; grid-template-columns: 1fr 252rpx; align-items: center; gap: 32rpx; min-height: 472rpx; padding: 56rpx 48rpx 68rpx; box-sizing: border-box; }
.aroma image { width: 252rpx; height: 252rpx; border-radius: 50%; box-shadow: 0 28rpx 64rpx rgba(53,42,28,.11); }
.kicker { display: block; color: #8b5540; font-size: 16rpx; font-weight: 700; letter-spacing: 4rpx; }
.section-title { display: block; margin-top: 20rpx; color: #183b2d; font-size: 50rpx; line-height: 1.35; }
.clay-rule { margin: 36rpx 0 32rpx; background: #b36e4b; }
.section-copy { color: #59655d; font-size: 24rpx; line-height: 1.7; letter-spacing: 3rpx; }
.section-dark { padding: 96rpx 56rpx 84rpx; background: #0d2b21; color: #f5efe4; }
.section-dark .kicker { color: #c78a6e; }
.section-dark .section-title { color: #f5efe4; font-size: 58rpx; white-space: pre-line; }
.body-copy { display: block; margin-top: 32rpx; color: rgba(245,239,228,.7); font-size: 22rpx; line-height: 1.9; }
.quote { display: block; margin-top: 60rpx; padding: 32rpx 0 0 36rpx; border-left: 4rpx solid #a96a4e; font-size: 30rpx; line-height: 1.8; }
.split-section { display: grid; grid-template-columns: 1fr 264rpx; align-items: center; gap: 40rpx; padding: 84rpx 48rpx; }
.split-section image { width: 264rpx; height: 368rpx; }
.split-section .section-title { font-size: 46rpx; }
.dark-copy { color: #687168; }
.wide-image { display: block; width: 100%; height: 550rpx; }
.tasting-copy, .leaf-copy { padding: 64rpx 52rpx 80rpx; }
.features { padding: 86rpx 48rpx 92rpx; background: #e8e0d2; }
.feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rpx; margin-top: 48rpx; background: rgba(24,59,45,.12); }
.feature-grid view { display: flex; align-items: center; gap: 24rpx; min-height: 148rpx; padding: 24rpx; box-sizing: border-box; background: #f4eee3; }
.feature-grid view > text:first-child { color: #a66a4e; font-family: Georgia, serif; font-size: 36rpx; }
.feature-grid view > text:last-child { color: #183b2d; font-size: 24rpx; font-weight: 600; line-height: 1.45; white-space: pre-line; }
.feature-last { grid-column: 1 / 3; }
.buybar { position: absolute; z-index: 8; right: 20rpx; bottom: calc(env(safe-area-inset-bottom) + 16rpx); left: 20rpx; display: grid; grid-template-columns: 1fr 104rpx 284rpx; min-height: 156rpx; align-items: center; gap: 18rpx; padding: 16rpx 18rpx 16rpx 36rpx; box-sizing: border-box; border: 1rpx solid rgba(24,59,45,.09); border-radius: 56rpx; background: rgba(255,255,255,.96); box-shadow: 0 24rpx 76rpx rgba(24,36,29,.16); }
.buy-size, .buy-price { display: block; }
.buy-size { color: #636d65; font-size: 22rpx; }
.buy-price { margin-top: 6rpx; color: #183b2d; font-family: Georgia, serif; font-size: 54rpx; line-height: 1; }
.buy-cart { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 0; padding: 0; border-radius: 50%; background: #efeee8; }
.buy-cart image { width: 48rpx; height: 48rpx; }
.buy-action { height: 110rpx; margin: 0; padding: 0; border-radius: 56rpx; background: #183b2d; color: #fff; font-size: 32rpx; line-height: 110rpx; letter-spacing: 4rpx; }
