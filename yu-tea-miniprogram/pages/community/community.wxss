page { background: #e9e4d9; }
.community-page { min-height: 100vh; padding: 48rpx 40rpx 90rpx; box-sizing: border-box; }
.community-title { display: block; margin: 18rpx 0 24rpx; font-size: 68rpx; line-height: 1.3; }
.community-title text { display: block; }
.intro { display: block; margin-bottom: 48rpx; color: #68736a; font-size: 24rpx; line-height: 1.85; }
.live-hero { position: relative; height: 810rpx; overflow: hidden; background: #0d2b21; color: #fff; }
.live-hero image { position: absolute; width: 100%; height: 100%; opacity: .7; }
.live-badge { position: absolute; top: 36rpx; left: 36rpx; color: #f3c7b9; font-size: 20rpx; letter-spacing: 2rpx; }
.live-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 140rpx; }
.live-copy text { display: block; font-size: 22rpx; letter-spacing: 2rpx; }
.live-copy .serif { margin-top: 14rpx; font-size: 46rpx; line-height: 1.45; letter-spacing: 0; }
.live-copy .serif text { display: block; font-size: inherit; letter-spacing: 0; }
.live-hero button { position: absolute; left: 40rpx; bottom: 40rpx; margin: 0; padding: 16rpx 26rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 0; background: rgba(10,35,26,.72); color: #fff; font-size: 20rpx; line-height: 1.4; }
.community-list { margin-top: 58rpx; }
.list-title { display: block; margin: 14rpx 0 28rpx; font-size: 48rpx; }
.community-list button { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; margin: 0; padding: 24rpx 0; border-top: 1rpx solid rgba(23,35,30,.13); border-radius: 0; background: transparent; text-align: left; line-height: 1.4; }
.community-list button view text { display: block; }
.community-list button view text:first-child { font-size: 26rpx; font-weight: 600; }
.community-list button view text:last-child { margin-top: 10rpx; color: #737b74; font-size: 18rpx; }
