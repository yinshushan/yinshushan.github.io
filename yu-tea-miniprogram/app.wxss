page {
  background: #f5f1e8;
  color: #17231e;
  font-family: "PingFang SC", sans-serif;
  font-size: 28rpx;
}

button {
  color: inherit;
  font-size: inherit;
}

button::after {
  border: 0;
}

.eyebrow {
  display: block;
  color: #6e846f;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.serif {
  font-family: "Songti SC", serif;
}

.section {
  padding: 64rpx 40rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 38rpx;
}

.section-heading .title {
  display: block;
  margin-top: 12rpx;
  font: 400 48rpx/1.3 "Songti SC", serif;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  padding: 0 34rpx;
  border-radius: 4rpx;
  background: #183b2d;
  color: #fff;
  font-size: 24rpx;
}
